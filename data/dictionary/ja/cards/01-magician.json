      "status": "draft"
    },
    "upright": {
      "text_ja": "技量や交渉力、自信を使う場面として読める一方、病気・苦痛・喪失・災難・敵の罠も原文にある。どの語群を採るかは問いと状況に依存し、成功を保証しない。",
      "kind": "source_based_editorial",
      "evidence_units": [
        "upright:0",
        "upright:1",
        "upright:4",
        "upright:6",
        "upright:9",
        "upright:10"
      ],
      "status": "draft"
    },
    "reversed": {
      "text_ja": "不名誉や不安を検討できる。医師・魔術師という人物指示も残るため、すべてを能力不足・欺瞞という一義的な読みにはまとめない。",
      "kind": "source_based_editorial",
      "evidence_units": [
        "reversed:0",
        "reversed:1",
        "reversed:3",
        "reversed:4"
      ],
      "status": "draft"
    },
    "application": {
      "text_ja": "自分の技量を何に使っているか、自信と実際の準備が対応しているか、という問いに使える。",
      "kind": "editorial_application",
      "evidence_units": [],
      "status": "draft"
    },
    "supplement_boundary": "「創造」「具現化」「逆位置は必ず詐欺・才能の浪費」といった定型句は今回の意味欄からは導入していない。",
    "rationale_ja": "evidence_unitsで指した原文語句から編集者が整理した読み。原文の翻訳でも、唯一の解釈でもない。applicationは原典にはない問いかけである。"
